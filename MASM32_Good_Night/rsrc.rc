  CONTROL "Shutdown",IDC_SHUTDOWN,"Button",0x50010009,4,7,66,9,0x00000000
  CONTROL "Reboot computer",IDC_REBOOT,"Button",0x50010009,4,22,104,9,0x00000000
END
IDI_SLEEP ICON DISCARDABLE "clock.ico"
IDB_MIN BITMAP DISCARDABLE "img_min.bmp"
IDD_ABOUT DIALOGEX 6,5,167,115
